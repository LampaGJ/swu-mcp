{
  "name": "swu-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Star Wars: Unlimited card data, scoring and synergy tools served over MCP",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "mcp": "tsx src/server.ts",
    "export:package": "tsx scripts/export-swu-data-package.ts",
    "card-features": "tsx scripts/card-features.ts",
    "synergy": "tsx scripts/synergy.ts",
    "fit:coefficients": "tsx scripts/fit-coefficients.ts",
    "score": "tsx scripts/score.ts",
    "rules:fetch": "tsx scripts/rules-fetch.ts",
    "rules:check": "tsx scripts/rules-check.ts",
    "market": "tsx scripts/market.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "^4.4.0",
    "minisearch": "^7.2.0",
    "stemmer": "^2.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@types/node": "^22",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "gpt-tokenizer": "^4.0.3",
    "prettier": "^3",
    "tsx": "^4.19.3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  }
}
