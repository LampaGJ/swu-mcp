{
  "name": "swu-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Star Wars: Unlimited card data, scoring and synergy tools served over MCP",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.27.0",
  "scripts": {
    "prepare": "node scripts/bundle.mjs",
    "build": "node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --check .",
    "mcp": "tsx src/server.ts",
    "build:data": "tsx scripts/build-data.ts",
    "package:zip": "tsx scripts/package-zip.ts",
    "export:package": "tsx scripts/export-swu-data-package.ts",
    "card-features": "tsx scripts/card-features.ts",
    "synergy": "tsx scripts/synergy.ts",
    "fit:coefficients": "tsx scripts/fit-coefficients.ts",
    "score": "tsx scripts/score.ts",
    "rules:fetch": "tsx scripts/rules-fetch.ts",
    "rules:check": "tsx scripts/rules-check.ts",
    "market": "tsx scripts/market.ts",
    "embed:capture": "tsx scripts/embed-capture.ts",
    "similarity": "tsx scripts/similarity.ts",
    "verify:audit": "tsx scripts/verify/audit.ts",
    "verify:sample": "tsx scripts/verify/sample.ts",
    "verify:pair-fixture": "tsx scripts/verify/pair-fixture.ts",
    "verify:pair-fixture:pin": "tsx scripts/verify/pair-fixture-pin.ts",
    "verify:pairs": "tsx scripts/verify/pair-precision.ts",
    "release:data": "tsx scripts/release-data.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@toon-format/toon": "^4.4.0",
    "@types/node": "^22",
    "cheerio": "^1.2.0",
    "env-paths": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "gpt-tokenizer": "^4.0.3",
    "minisearch": "^7.2.0",
    "prettier": "^3",
    "stemmer": "^2.0.1",
    "tar": "^7.5.22",
    "tsx": "^4.19.3",
    "typescript": "^5.9",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4",
    "zod": "^4.3.6"
  },
  "bin": {
    "swu-mcp": "dist/server.js"
  },
  "files": [
    "dist",
    "data/rubric-coefficients.json",
    "data/rules-core.json",
    "data/complementarity.json",
    "src/data-release.json"
  ]
}
